# This service is intentionally loopback-only. HOST is documented but ignored.
HOST=127.0.0.1
PORT=8765
RENDER_SERVER_TOKEN=

# Create an OAuth application at https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Absolute Windows paths are recommended. FFMPEG_PATH may also be "ffmpeg".
DANSER_PATH=C:\osu-renderer\danser\danser-cli.exe
FFMPEG_PATH=ffmpeg
OSU_SONGS_PATH=C:\Users\USERNAME\AppData\Local\osu!\Songs
OSU_SKINS_PATH=C:\Users\USERNAME\AppData\Local\osu!\Skins
OSU_STANDARD_SKIN=osu-pulse Appu
OSU_MANIA_SKIN=osu-pulse R Skin v3.0 Bars

# Installed automatically by start_renderer.bat (Python 3.12+ is required).
MANIA_PYTHON_PATH=.\renderer\.venv-mania\Scripts\python.exe
MANIA_RENDERER_SOURCE=.\renderer\local\osu-mania-renderer

TEMP_PATH=./renderer/temp
OUTPUT_PATH=./renderer/output
LOG_PATH=./renderer/logs
BEATMAP_INDEX_PATH=./renderer/beatmap-index.json
RENDER_STATS_PATH=./renderer/stats.json

# Missing sets are resolved by official osu! checksum lookup, then downloaded
# from the no-auth Hinamizawa .osz proxy. no-video saves bandwidth.
AUTO_DOWNLOAD_BEATMAPS=true
BEATMAP_DOWNLOAD_NO_VIDEO=true
MAX_BEATMAPSET_BYTES=268435456

MAX_CONCURRENT_RENDERS=1
MAX_JOBS_PER_USER=2
MAX_REPLAY_BYTES=16777216
RENDER_TIMEOUT_SECONDS=1800
OUTPUT_RETENTION_HOURS=24
KEEP_FAILED_TEMP=false

# auto = prefer NVIDIA NVENC, then AMD AMF, after real encode probes; otherwise use libx264.
VIDEO_ENCODER=auto
DANSER_SETTINGS=default

# Re-encode the finished MP4 before R2/Blob upload. 24 is a balanced H.264 quality value.
VIDEO_COMPRESS=true
VIDEO_COMPRESS_QUALITY=24
VIDEO_COMPRESS_AUDIO_KBPS=160
VIDEO_COMPRESS_TIMEOUT_SECONDS=7200

# Optional outbound bridge. This keeps the local API bound to 127.0.0.1 while
# allowing the Vercel /render page to enqueue work. Never expose these tokens.
RENDER_CLOUD_URL=https://osu-pulse.vercel.app
RENDER_BRIDGE_TOKEN=
BLOB_READ_WRITE_TOKEN=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=osu-video-disk
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_URL_EXPIRES_SECONDS=604800
VIDEO_SHARE_TIMEOUT_SECONDS=7200

# Optional YouTube auto-upload. Run renderer/configure_youtube.py instead of
# entering the OAuth refresh token manually. Uploads request unlisted privacy.
YOUTUBE_AUTO_UPLOAD=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=20
YOUTUBE_UPLOAD_TIMEOUT_SECONDS=7200
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608

RENDER_CLOUD_POLL_SECONDS=5
RENDERER_ID=local-renderer
RENDER_NODE_PATH=node
