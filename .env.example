# Provisioned by Vercel Marketplace (Neon)
DATABASE_URL=
LOCAL_WEB_ORIGIN=
YT_DLP_YOUTUBE_CLIENT=web_embedded
# Optional: preserve the former Neon connection for a later delta import.
NEON_DATABASE_URL=
LOCAL_DATABASE_POOL_SIZE=5
# Server-side query/lock deadlines (milliseconds); prevent a blocked worker
# from waiting forever. Statement timeout: 5000-300000, lock timeout: 1000-60000.
LOCAL_DATABASE_STATEMENT_TIMEOUT_MS=60000
LOCAL_DATABASE_LOCK_TIMEOUT_MS=5000
# One-time source for `npm run db:migrate:legacy-supabase`.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SECRET_KEY=

# osu! OAuth client credentials: https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Abort slow token/API requests so the next polling cycle can retry.
OSU_API_TIMEOUT_MS=20000

# Spotify Web API (playlist titles are resolved to playable YouTube audio by the local Bot)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Discord Developer Portal application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# Public URL of the deployed dashboard
# Local Node.js server. When Cloudflare Quick Tunnel is running, its current
# HTTPS URL is discovered automatically from work/public-web-url.txt.
WEB_APP_URL=http://127.0.0.1:3000
OSU_PULSE_PUBLIC_URL_FILE=work/public-web-url.txt

# Generated server-only secrets
INTERNAL_API_SECRET=
CRON_SECRET=
# Private Web UI login. If omitted, WEB_RENDER_ACCESS_KEY is used as the keyphrase.
CONTROL_PANEL_KEYPHRASE=
# Cookie signing and encrypted settings. If omitted, INTERNAL_API_SECRET is used.
CONTROL_PANEL_SESSION_SECRET=
WEB_RENDER_ACCESS_KEY=
RENDER_BRIDGE_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Lavalink v4 node (the Discord gateway worker uses these)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me
LAVALINK_SECURE=false
# Default player volume and preferred source ceiling. Lower-bitrate sources are not upscaled.
MUSIC_DEFAULT_VOLUME=30
MUSIC_PREFERRED_BITRATE_KBPS=256
BOT_AUDIO_DIR=bot-audio
BOT_AUDIO_MAX_BITRATE_KBPS=256
BOT_AUDIO_MAX_UPLOAD_BYTES=209715200
# BOT_AUDIO_FFMPEG_PATH=ffmpeg
# BOT_AUDIO_FFPROBE_PATH=ffprobe
# Optional. Defaults to yt-dlp on PATH. Set the full executable path if needed.
YT_DLP_PATH=
# Local HTTP audio relay used only between the Bot and Lavalink.
YT_DLP_PROXY_PORT=2334
YT_DLP_PROXY_TOKEN=replace-with-a-long-random-value
# Only required when Lavalink runs on another machine and can reach this HTTPS origin.
YT_DLP_PROXY_ORIGIN=

# Worker tuning
OSU_POLL_MIN_MS=120000
OSU_POLL_MAX_MS=180000
SCORE_NOTIFICATION_LOOKBACK_HOURS=6

# Optional local osu! replay renderer. The Bot never starts this process.
RENDER_SERVER_URL=http://127.0.0.1:8765
RENDER_SERVER_TOKEN=
RENDER_HEALTH_TIMEOUT_MS=5000
RENDER_REQUEST_TIMEOUT_MS=10000
RENDER_POLL_INTERVAL_MS=4000
RENDER_POLL_TIMEOUT_MS=2100000
RENDER_MAX_REPLAY_BYTES=16777216

# Discord status voice-channel names (minimum 15000 ms; Discord may rate-limit renames)
STATUS_CHANNEL_NAME_INTERVAL_MS=15000

# Completed renders: compress first, then prefer R2 when credentials are present.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=osu-video-disk
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public custom domain or r2.dev URL. Without it, a 7-day signed URL is returned.
R2_PUBLIC_BASE_URL=
R2_URL_EXPIRES_SECONDS=604800
RENDER_SHARE_TIMEOUT_MS=7200000
RENDER_SCHEDULE_ENABLED=true
RENDER_ALLOWED_START_TIME=01:00
RENDER_ALLOWED_END_TIME=07:00
RENDER_IDLE_ONLY=true
RENDER_IDLE_MINUTES=10
